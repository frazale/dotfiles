// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "alt-h": "vim::Left",
      "alt-j": "vim::Down",
      "alt-l": "vim::Right",
      "alt-k": "vim::Up",
      "ctrl-k": "editor::ShowSignatureHelp",
    },
  },
  {
    "context": "!(vim_mode == insert) && !Picker",
    "bindings": {
      "ctrl-e": "project_panel::ToggleFocus",
      "ctrl-shift-e": "project_panel::Toggle",
      "ctrl-enter": "agent::ToggleFocus",
      "ctrl-shift-enter": "agent::Toggle",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-shift-h": "workspace::MovePaneLeft",
      "ctrl-shift-l": "workspace::MovePaneRight",
      "ctrl-shift-j": "workspace::MovePaneDown",
      "ctrl-shift-k": "workspace::MovePaneUp",
      "ctrl-t": "terminal_panel::Toggle",
      "shift-h": "vim::GoToPreviousTab",
      "shift-l": "vim::GoToTab",
      "shift-k": "editor::Hover",
      "ctrl-s": "vim::HelixJumpToWord",
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
    },
  },
  {
    "context": "(vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "space g": "text_finder::Toggle",
      "space a": "editor::ToggleCodeActions",
      "space f": "file_finder::Toggle",
      "space b d": "pane::CloseActiveItem",
      "space b D": "pane::CloseAllItems",
      "space t t": "task::Rerun",
      "space t n": "task::Spawn",
      "space w q": "pane::CloseActiveItem",
      "ctrl-p": [
        "task::Spawn",
        {
          "task_name": "Television file finder",
          "reveal_target": "center",
        },
      ],
    },
  },
  {
    "context": "Editor && showing_completions",
    "unbind": {
      "enter": "editor::ConfirmCompletion",
    },
  },
]
